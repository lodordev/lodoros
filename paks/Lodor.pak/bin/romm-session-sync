#!/bin/sh
# romm-session-sync <pull|push> <rom-path> | report <rom-path> <start-epoch> <end-epoch> — sync ONE
# ROM's save (pull/push), or report a finished play session (report), WiFi-dark. Called by the minarch
# shim around a game launch. Taking the ROM path as an argument keeps quoting safe (ROM names have
# spaces and parens). Always exits 0 — a game launch must never be blocked by sync.

PHASE="$1"
ROM="$2"
[ -n "$PHASE" ] && [ -n "$ROM" ] || exit 0

SDCARD="${SDCARD_PATH:-/mnt/SDCARD}"
PLAT="${PLATFORM:-miyoomini}"
PAK="$SDCARD/Tools/$PLAT/Lodor.pak"
WIFI_LOG="$PAK/session.log"

. "$PAK/lib/romm-sync-lib.sh" 2>/dev/null || exit 0
SESSION_LOG="$PAK/session.log"

# Always power the radio down if we're killed (e.g. the shim caps the pull with `timeout`, or OOM).
# wifi_release is owner-safe → no-ops unless we hold it.
trap 'wifi_release' EXIT INT TERM HUP QUIT

# REPORT phase (play-session telemetry): feed cross-device Continue/recently-played from the server.
# Pure telemetry — best-effort, never blocks the return to the menu. The shim only invokes this when
# WiFi is ALREADY up, so wifi_acquire reuses the warm link (no cold bring-up on a quit); the radio is
# never powered down here (wifi_release drops the mutex only). Args: $2=rom $3=start-epoch $4=end-epoch.
if [ "$PHASE" = "report" ]; then
	START="$3"; END="$4"
	[ -n "$START" ] && [ -n "$END" ] || exit 0
	if wifi_acquire push; then
		set_clock >/dev/null 2>&1
		# rc=2 = the engine does not implement --report-session (an older on-card binary;
		# a usage dump otherwise spams the log). Quiet skip. The current engine's mode
		# ALWAYS exits 0 (telemetry never blocks a quit), so rc here is 0/2/timeout-124
		# only — never the >=3 fail-reason band run_sync persists for real sync modes.
		run_sync --report-session "$ROM" --started "$START" --ended "$END" >> "$SESSION_LOG" 2>/dev/null
		rc=$?
		wifi_release
		if [ "$rc" = 2 ]; then
			echo "$(date +'%F %T') [report] skipped (engine lacks --report-session) rom=$ROM" >> "$SESSION_LOG"
		else
			echo "$(date +'%F %T') [report] rom=$ROM rc=$rc" >> "$SESSION_LOG"
		fi
	else
		echo "$(date +'%F %T') [report] wifi busy/unavailable rom=$ROM" >> "$SESSION_LOG"
	fi
	exit 0
fi

if [ "$PHASE" = "pull" ]; then
	# Skip the pre-game pull if a full sync already refreshed everything recently.
	now=$(date +%s); last=$(cat /tmp/romm-last-full-sync 2>/dev/null || echo 0)
	if [ $((now - last)) -lt "${ROMM_SYNC_INTERVAL:-1800}" ]; then
		echo "$(date +'%F %T') [pull] skipped (fresh) rom=$ROM" >> "$SESSION_LOG"
		exit 0
	fi
	NET_TIMEOUT=6   # fail fast pre-game; the daemon owns the patient path
fi

# Pull (user launching a game) is foreground and PREEMPTS a push; the post-game push is preemptible.
[ "$PHASE" = "push" ] && _ACQ=push || _ACQ=fg
if wifi_acquire "$_ACQ"; then
	set_clock >/dev/null 2>&1
	# Two targeted engine modes, one per phase:
	#  PHASE=pull (pre-game): --sync-save <rom> does a newest-wins pull then a push the engine
	#    dedupes to a no-op via AlreadyOnServer MD5 when the local save is unchanged.
	#  PHASE=push (post-game HYBRID): --push-save <rom> pushes the changed save DIRECTLY and, on a
	#    verified land, writes last-synced.txt (the launcher's synced-✓ signal); a push that does
	#    NOT land is staged into pending-saves.txt for later upload. The shim only invokes the push
	#    phase when WiFi is ALREADY up, so wifi_acquire reuses the warm link (no cold bring-up on a
	#    quit) and the radio is never powered down here (wifi_release drops the mutex only).
	if [ "$PHASE" = push ]; then
		run_sync --push-save "$ROM" >> "$SESSION_LOG" 2>&1
		rc=$?
		# Handoff v1: push new save STATES on the warm link too (additive; engine
		# dedups; dark without statecores.json; never affects rc/contract), then
		# drain any states queued from offline stops.
		run_sync --push-states "$ROM" >> "$SESSION_LOG" 2>&1 || true
		run_sync --push-pending-states >> "$SESSION_LOG" 2>&1 || true
	elif [ -x "$PAK/lodor-wizard" ]; then
		# Launch gate (Handoff, task #24 - 2026-07-07): the wizard probes
		# for anything NEWER (save lineage; unseen compatible state) and shows the
		# interactive launch card ONLY then - silent pass-through otherwise. Wizard
		# not shipped in this pak build -> the old silent sync below (honest
		# degradation; release.sh only started bundling it post-0.9.6). resolv +
		# tier-1 prep first: the wizard's engine probes bypass run_sync's plumbing.
		_ensure_resolv
		lodor_tier1_up
		LODOR_BIN="$PAK/lodor-sync" \
			timeout 90 "$PAK/lodor-wizard" --launch-card "$ROM" >> "$SESSION_LOG" 2>&1 || true
		rc=0
	else
		run_sync --sync-save "$ROM" >> "$SESSION_LOG" 2>&1
		rc=$?
	fi
	wifi_release
	echo "$(date +'%F %T') [$PHASE] rom=$ROM rc=$rc" >> "$SESSION_LOG"
else
	if [ "$PHASE" = push ]; then
		# Handoff v1: no link — record the possibly-unpushed states for the
		# online drain (--queue-state is offline + instant, never blocks a quit).
		run_sync --queue-state "$ROM" >> "$SESSION_LOG" 2>&1 || true
	fi
	echo "$(date +'%F %T') [$PHASE] wifi busy/unavailable rom=$ROM" >> "$SESSION_LOG"
fi
exit 0
